# Web 版环境变量
# 复制此文件为 .env 并填入实际值

# 访问密码（不设置则使用默认密码 image-forge）
VITE_ACCESS_PASSWORD=your-password-here


# Vercel Blob：前端不再持有任何 Token。在 Vercel 项目设置 → Environment Variables
# 里配置服务端变量 BLOB_READ_WRITE_TOKEN（不要加 VITE_ 前缀、不要写进任何 .env），
# 图片上传/删除经 /api/blob/* 服务端签发短时令牌完成。

# 开发服务器监听地址：默认 127.0.0.1（仅本机）。
# 需要局域网设备访问时设为 true（监听 0.0.0.0）——数据服务会暴露 ~/.image-forge
# （含 API Key 明文），务必同时配置下方令牌。
VITE_DEV_EXPOSE=false

# 开发数据服务访问令牌（可选）：配置后 /__* 读写与文件写入/删除端点要求携带
# x-if-data-token 头（静态图片 GET 不受影响）。公网/隧道访问时建议启用。
#VITE_DEV_DATA_TOKEN=change-me-to-a-long-random-string
