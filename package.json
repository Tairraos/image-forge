{
  "name": "image-forge",
  "private": true,
  "version": "1.0.94",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "tauri": "tauri",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "check": "pnpm lint && pnpm test && cargo check --manifest-path src-tauri/Cargo.toml",
    "verify": "node scripts/verify.mjs",
    "fix": "eslint . --fix && prettier --write .",
    "ship": "node scripts/ship.mjs",
    "patch": "node scripts/patch-version.mjs",
    "migrate:data": "node scripts/migrate-data-root.mjs",
    "prerelease": "node scripts/prerelease.mjs",
    "release": "node scripts/release.mjs",
    "sync:web": "node scripts/sync-desktop-to-web.mjs",
    "sync:web:serve": "node scripts/sync-desktop-to-web.mjs --serve",
    "sync:desktop": "node scripts/sync-web-to-desktop.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@iconify-icons/icon-park-solid": "^1.2.8",
    "@iconify/vue": "^5.0.1",
    "@lucide/vue": "^1.23.0",
    "@tauri-apps/api": "^2.11.1",
    "dexie": "^4.4.5",
    "jszip": "^3.10.1",
    "markdown-it": "^14.3.0",
    "naive-ui": "^2.44.1",
    "vue": "^3.5.39"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
